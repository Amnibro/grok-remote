{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*", "http://127.0.0.1:*/*", "http://localhost:*/*"]
  }
}
