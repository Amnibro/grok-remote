{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grok Remote",
  "version": "1.4.4",
  "identifier": "ai.amniscient.grok-remote-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grok Remote",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
